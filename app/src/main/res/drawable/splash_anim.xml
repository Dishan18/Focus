<?xml version="1.0" encoding="utf-8"?>
<!-- Launch animation: the ring sweeps round while the dot pops in. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="108dp" android:height="108dp"
            android:viewportWidth="108" android:viewportHeight="108">
            <group android:name="ring" android:pivotX="54" android:pivotY="54">
                <path
                    android:pathData="M54,34 A20,20 0 1,1 35.2,47.2"
                    android:strokeWidth="6"
                    android:strokeLineCap="round"
                    android:strokeColor="#FFFFFFFF"
                    android:fillColor="#00000000" />
            </group>
            <group android:name="dot" android:pivotX="54" android:pivotY="54"
                android:scaleX="0" android:scaleY="0">
                <path
                    android:pathData="M54,54m-5,0a5,5 0 1,1 10,0a5,5 0 1,1 -10,0"
                    android:fillColor="#FFB8F2E6" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="ring">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="rotation"
                android:valueFrom="-140" android:valueTo="0" android:duration="700"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="dot">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0" android:valueTo="1"
                    android:startOffset="300" android:duration="400"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0" android:valueTo="1"
                    android:startOffset="300" android:duration="400"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
