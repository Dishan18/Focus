<resources>
    <style name="Theme.Regain" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">#FF8B7CFF</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_anim</item>
        <item name="android:windowSplashScreenAnimationDuration">700</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#FF241B5C</item>
    </style>

    <!-- The gate must appear instantly: no visible splash. -->
    <style name="Theme.Regain.Shield">
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/black</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
